# Public browser configuration. These values are safe to expose in a client build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only runtime configuration. Never prefix these variables with VITE_.
SUPABASE_URL=
# Optional server-side aliases used by authenticated server functions. These
# values are public Supabase configuration, unlike the service role key below.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# WhatsApp Cloud API webhook validation. Server-side only; never use VITE_.
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
